{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DiamondDogz/crowbar-sdk/main/schema/crowbar.schema.json",
  "title": "crowbar.json",
  "description": "How Crowbar starts a PS4RT runtime and what the runtime supports. See SPEC.md.",
  "type": "object",
  "required": [
    "crowbar",
    "name",
    "game",
    "titleIds",
    "launch"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "crowbar": {
      "description": "Format version.",
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "description": "Runtime name shown in Crowbar.",
      "type": "string",
      "minLength": 1
    },
    "game": {
      "description": "Catalog id of the game.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "titleIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(CUSA|PLJS|PLJM|PCJS|PCAS|PLAS)[0-9]{5}$"
      }
    },
    "requiredVersion": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}$"
    },
    "launch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "windows": {
          "$ref": "#/$defs/command"
        },
        "linux": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "string",
      "minLength": 1
    },
    "backup": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "trophies": {
          "type": "boolean"
        },
        "trophyCard": {
          "type": "boolean"
        },
        "pause": {
          "type": "boolean",
          "description": "The game can be paused from Crowbar's Guide menu through PS4RT_CONTROL_DIR (SPEC §4)."
        },
        "dlc": {
          "$ref": "#/$defs/args",
          "contains": {
            "type": "string",
            "pattern": "\\{file\\}"
          }
        },
        "updatePkg": {
          "$ref": "#/$defs/args",
          "contains": {
            "type": "string",
            "pattern": "\\{file\\}"
          }
        },
        "updateFolder": {
          "$ref": "#/$defs/args",
          "contains": {
            "type": "string",
            "pattern": "\\{dir\\}"
          }
        },
        "noDialogs": {
          "$ref": "#/$defs/args"
        }
      }
    },
    "options": {
      "type": "array",
      "description": "Settings shown by Crowbar for this runtime (keys and values of the settings .ini).",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "values",
          "default"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\-]+$"
          },
          "label": {
            "$ref": "#/$defs/text"
          },
          "hint": {
            "$ref": "#/$defs/text"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "default": {
            "type": "string"
          }
        }
      }
    },
    "trophyFile": {
      "type": "string",
      "description": "Where the runtime writes its trophy unlocks, relative to the root; {data} and {titleId} allowed, * in the file name and its folder (SPEC section 2). Default {data}/user/trophies.json."
    },
    "trophyFormat": {
      "enum": [
        "sdk",
        "ps4rt-unlocks",
        "trg-progress"
      ],
      "description": "Format of trophyFile: sdk (JSON of section 2, default), ps4rt-unlocks (PS4RT-UNLOCKS 1, then <id> <unix seconds>), trg-progress (unlocked <id> <unix seconds>)."
    },
    "language": {
      "type": "object",
      "required": [
        "env"
      ],
      "properties": {
        "env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "values": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "description": "The variable that sets the game language, and its value for each PS4 language number. PS4RT_LANGUAGE is passed as well."
    },
    "minCrowbar": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SDK 1.5: oldest Crowbar version this runtime needs, as \"0.3.0\". An older Crowbar asks the player to update."
    },
    "mods": {
      "type": "object",
      "required": [
        "dir"
      ],
      "description": "SDK 1.5: the runtime reads mods from this folder; Crowbar shows it in the game's Add-ons.",
      "properties": {
        "dir": {
          "type": "string",
          "description": "Relative to the runtime; {data} and {titleId} allowed."
        },
        "help": {
          "type": "string",
          "description": "Short text telling players how to install a mod."
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "args": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
